<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>mica-ppocr-solon-plugin</artifactId>
    <name>${project.artifactId}</name>
    <description>mica-ppocr solon-plugin，一行配置即可接入 OCR 文字识别</description>

    <parent>
        <groupId>net.dreamlu</groupId>
        <artifactId>mica-ppocr</artifactId>
        <version>${revision}</version>
    </parent>

    <dependencies>
        <dependency>
            <groupId>net.dreamlu</groupId>
            <artifactId>mica-ppocr-core</artifactId>
        </dependency>
        <dependency>
            <groupId>net.dreamlu</groupId>
            <artifactId>mica-ppocr-structured</artifactId>
        </dependency>
        <!--
            mica-ppocr-pdf 默认引入 solon-plugin：
            - mica-ppocr-pdf 自身把 pdfbox 标 optional=true（防止传递污染 PDF 模块外的下游）
            - solon-plugin 显式拉 pdfbox（与 spring-boot-starter 行为对齐）：
                启动时 solon 的 bean 扫描会按引用解析类图，pdfbox 必须在插件自身 classpath
            - 装配期由 PdfAutoConfiguration 的 @Condition(onClass=PdfOcrSupport) 二次保护
        -->
        <dependency>
            <groupId>net.dreamlu</groupId>
            <artifactId>mica-ppocr-pdf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
        </dependency>
        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>solon</artifactId>
        </dependency>
        <!--
            编译期生成 META-INF/solon/solon-configuration-metadata.json，
            配合 solon-idea-plugin 提供 app.yml / app.properties 的配置提示。
            scope=provided：仅编译期需要，不随插件 jar 发布。
        -->
        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>solon-configuration-processor</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>solon-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                父 pom 已声明 lombok 子模块 override 时必须重新列出全部 processor，
                否则父级的 annotationProcessorPaths 会被完全替换。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                        <path>
                            <groupId>org.noear</groupId>
                            <artifactId>solon-configuration-processor</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
