<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>mica-ppocr-pdf</artifactId>
    <name>${project.artifactId}</name>
    <description>mica-ppocr PDF 双通道模块：文字型 PDF 直接抽文本层坐标（字符无损），扫描件渲染位图走 OCR 兜底</description>

    <parent>
        <groupId>net.dreamlu</groupId>
        <artifactId>mica-ppocr</artifactId>
        <version>${revision}</version>
    </parent>

    <dependencies>
        <dependency>
            <groupId>net.dreamlu</groupId>
            <artifactId>mica-ppocr-core</artifactId>
        </dependency>
        <!--
            pdfbox 是 PDF 解析必需依赖，标记 optional=true 防止传递污染下游：
            业务方需要 PDF 通道时显式引入 mica-ppocr-pdf；只用图片 OCR 的项目
            不会背上一个 ~7MB 的 pdfbox 及其 native/fontbox 传递依赖。
        -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 端到端对照测试：把 PDF 抽取/OCR 结果喂给 InvoiceParser -->
        <dependency>
            <groupId>net.dreamlu</groupId>
            <artifactId>mica-ppocr-structured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.dreamlu</groupId>
            <artifactId>mica-auto</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

</project>
